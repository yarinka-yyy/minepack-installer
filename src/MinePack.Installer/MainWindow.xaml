<Window x:Class="MinePack.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MinePack.Installer"
        Title="MinePack" Icon="Assets/MinePackIcon.ico" Width="850" Height="730" MinWidth="710" MinHeight="610"
        WindowStartupLocation="CenterScreen" Background="#493526" Foreground="#FFF4DF"
        FontFamily="/MinePack.Installer;component/Assets/#Monocraft" FontSize="17"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DrawingBrush x:Key="Dirt" TileMode="Tile" Viewport="0,0,96,96" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#6B4A32" Geometry="M0,0 H96 V96 H0 Z"/>
                    <GeometryDrawing Brush="#79553A" Geometry="M0,0 H24 V16 H0 Z M48,0 H80 V16 H48 Z M16,32 H48 V48 H16 Z M64,48 H96 V64 H64 Z M0,80 H32 V96 H0 Z"/>
                    <GeometryDrawing Brush="#523922" Geometry="M24,0 H40 V16 H24 Z M80,16 H96 V32 H80 Z M0,48 H16 V64 H0 Z M48,64 H64 V80 H48 Z"/>
                    <GeometryDrawing Brush="#8B6341" Geometry="M40,16 H64 V32 H40 Z M0,32 H16 V48 H0 Z M48,48 H64 V64 H48 Z M16,64 H32 V80 H16 Z M80,80 H96 V96 H80 Z"/>
                    <GeometryDrawing Brush="#A0754A" Geometry="M64,0 H80 V8 H64 Z M32,48 H48 V56 H32 Z M0,64 H16 V72 H0 Z M72,32 H88 V40 H72 Z"/>
                    <GeometryDrawing Brush="#3D2E22" Geometry="M0,16 H8 V24 H0 Z M64,24 H72 V32 H64 Z M24,80 H40 V88 H24 Z M80,64 H88 V72 H80 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="GrassEdge" TileMode="Tile" Viewport="0,0,96,64" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#6C4A30" Geometry="M0,0 H96 V64 H0 Z"/>
                    <GeometryDrawing Brush="#5C9B38" Geometry="M0,0 H96 V26 H0 Z M8,26 H20 V40 H8 Z M48,26 H64 V38 H48 Z M80,26 H92 V44 H80 Z"/>
                    <GeometryDrawing Brush="#78B647" Geometry="M0,0 H16 V13 H0 Z M32,0 H48 V12 H32 Z M64,0 H80 V16 H64 Z M20,16 H32 V26 H20 Z M72,16 H88 V26 H72 Z"/>
                    <GeometryDrawing Brush="#3F762A" Geometry="M16,0 H32 V10 H16 Z M48,0 H64 V8 H48 Z M0,20 H12 V30 H0 Z M36,24 H48 V34 H36 Z M64,24 H76 V32 H64 Z"/>
                    <GeometryDrawing Brush="#4E3423" Geometry="M0,48 H16 V64 H0 Z M32,36 H48 V52 H32 Z M64,48 H80 V64 H64 Z"/>
                    <GeometryDrawing Brush="#9A7047" Geometry="M16,44 H32 V56 H16 Z M48,48 H64 V60 H48 Z M80,44 H96 V56 H80 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="DarkWood" TileMode="Tile" Viewport="0,0,96,96" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#32271D" Geometry="M0,0 H96 V96 H0 Z"/>
                    <GeometryDrawing Brush="#3D3022" Geometry="M0,8 H96 V20 H0 Z M0,44 H96 V52 H0 Z M0,76 H96 V88 H0 Z"/>
                    <GeometryDrawing Brush="#493724" Geometry="M8,12 H40 V18 H8 Z M56,48 H88 V54 H56 Z M16,80 H64 V86 H16 Z"/>
                    <GeometryDrawing Brush="#251E18" Geometry="M0,32 H96 V36 H0 Z M0,64 H96 V68 H0 Z M24,0 H32 V8 H24 Z M72,52 H80 V64 H72 Z"/>
                    <GeometryDrawing Brush="#53402B" Geometry="M40,22 H72 V28 H40 Z M0,60 H24 V64 H0 Z M64,92 H96 V96 H64 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <SolidColorBrush x:Key="Ink" Color="#FFF4DF"/>
        <SolidColorBrush x:Key="SoftInk" Color="#E1CEAA"/>
        <SolidColorBrush x:Key="Green" Color="#3E9638"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftInk}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="WoodPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DarkWood}"/>
            <Setter Property="BorderBrush" Value="#18130E"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#777879"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#171717"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border BorderBrush="#66FFFFFF" BorderThickness="2,2,0,0" Margin="3,3,3,3"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FCE48B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InstallButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="66"/>
        </Style>
        <Style x:Key="PackChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="#4A3826" BorderBrush="#1B150F"
                                BorderThickness="2" SnapsToDevicePixels="True">
                            <Grid Margin="12,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="SelectionMark" Grid.Column="1" Width="20" Height="20"
                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                        Background="#777879" BorderBrush="#171717" BorderThickness="2"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionMark" Property="Background" Value="{StaticResource Green}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#5C472F"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FCE48B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CatalogExpander" TargetType="Expander">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="#4A3826" Foreground="{StaticResource Ink}"
                                          BorderBrush="#1B150F" BorderThickness="2"
                                          MinHeight="{TemplateBinding MinHeight}"
                                          FontSize="{TemplateBinding FontSize}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <DockPanel Margin="10,5">
                                                <TextBlock x:Name="Sign" Text="+" Width="26"
                                                           FontSize="{TemplateBinding FontSize}" FontWeight="Bold"
                                                           Foreground="#9AE56B" VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Sign" Property="Text" Value="−"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Background" Value="#5C472F"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="#FCE48B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CatalogOuterExpander" TargetType="Expander" BasedOn="{StaticResource CatalogExpander}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="#4A3826" Foreground="{StaticResource Ink}"
                                          BorderBrush="#1B150F" BorderThickness="2"
                                          MinHeight="{TemplateBinding MinHeight}"
                                          FontSize="{TemplateBinding FontSize}" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <StackPanel Orientation="Horizontal" Margin="10,5">
                                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                <TextBlock x:Name="Sign" Text="+" Width="26" Margin="8,0,0,0"
                                                           FontSize="{TemplateBinding FontSize}" FontWeight="Bold"
                                                           Foreground="#9AE56B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Sign" Property="Text" Value="−"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Background" Value="#5C472F"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="#FCE48B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProgressStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#211A14" BorderBrush="#120D09" BorderThickness="3" Height="18">
                            <Grid x:Name="Track">
                                <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                                <Rectangle x:Name="PART_Indicator" Fill="{StaticResource Green}"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Dirt}">
        <Border Height="64" Background="{StaticResource GrassEdge}" VerticalAlignment="Top"/>
        <ScrollViewer x:Name="MainContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly" Margin="0">
            <StackPanel Margin="24,28,24,28" MaxWidth="800">
                <Border Style="{StaticResource WoodPanel}" Margin="0,0,0,12" Padding="20,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MINEPACK" FontFamily="/MinePack.Installer;component/Assets/#Monocraft"
                                       FontSize="34" FontWeight="Bold" Foreground="#B5F18B"/>
                            <TextBlock Grid.Column="1" Text="{loc:Localized Key=UiMinecraftVersion}"
                                       FontSize="21" FontWeight="Bold" Foreground="#C8F5A8"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{loc:Localized Key=UiSubtitle}" FontSize="22"
                                   FontWeight="Bold" Margin="0,5,0,7"/>
                        <TextBlock Text="{loc:Localized Key=UiDescription}"
                                   FontSize="17" LineHeight="25"/>
                        <Border Background="#231B15" BorderBrush="#5E5438" BorderThickness="2"
                                Margin="0,13,0,0" Padding="10,7">
                            <TextBlock Text="{loc:Localized Key=UiRequirements}"
                                       FontSize="16" Foreground="#F7E7BB"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WoodPanel}" Margin="0,0,0,12" Padding="16,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Localized Key=UiChoosePack}" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="PackCountsText" Grid.Column="1" FontSize="15"
                                       Foreground="{StaticResource SoftInk}" HorizontalAlignment="Right"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <UniformGrid Columns="2" Rows="1">
                            <RadioButton x:Name="VanillaPlusOption" Content="Vanilla Plus" GroupName="PackChoice"
                                         IsChecked="True" Style="{StaticResource PackChoice}" Margin="0,0,5,0"/>
                            <RadioButton x:Name="Vanilla2PlusOption" Content="Frontier" GroupName="PackChoice"
                                         Style="{StaticResource PackChoice}" Margin="5,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WoodPanel}" Margin="0,0,0,12">
                    <Expander Header="{loc:Localized Key=UiCatalogTitle}" Style="{StaticResource CatalogOuterExpander}"
                              FontSize="22" MinHeight="50" IsExpanded="False">
                        <ItemsControl x:Name="CatalogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Heading}" IsExpanded="False"
                                              Style="{StaticResource CatalogExpander}" FontSize="15"
                                              MinHeight="32" Margin="0,0,0,3">
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="8,2,8,9">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#261F18" BorderBrush="#55402B"
                                                            BorderThickness="0,0,0,1" Padding="12,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="17"/>
                                                            <TextBlock FontSize="14" Margin="0,3,0,0">
                                                                <Hyperlink NavigateUri="{Binding ModrinthUrl}"
                                                                           RequestNavigate="ModrinthLink_RequestNavigate"
                                                                           Foreground="#A8E789"
                                                                           TextDecorations="Underline"><Run Text="{loc:Localized Key=UiOpenOnModrinth}"/></Hyperlink>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Border>

                <Border Style="{StaticResource WoodPanel}" Margin="0,0,0,12" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Localized Key=UiInstallLocation}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BrowseButton" Content="{loc:Localized Key=UiBrowse}" Style="{StaticResource ActionButton}"
                                    DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click"/>
                            <TextBox x:Name="InstallRootBox" MinHeight="48" VerticalContentAlignment="Center"
                                     Padding="9,5" Background="#1B1713" Foreground="#FFF4DF"
                                     BorderBrush="#8E7D5D" BorderThickness="2" FontSize="16"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="InstallButton" Content="{loc:Localized Key=UiInstall}"
                        Style="{StaticResource InstallButtonStyle}" IsDefault="True"
                        Margin="0,2,0,12" Click="Install_Click"/>

                <Border Style="{StaticResource WoodPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="CancelButton" Content="{loc:Localized Key=UiCancel}" Style="{StaticResource ActionButton}"
                                    DockPanel.Dock="Right" Visibility="Collapsed" IsEnabled="False"
                                    Margin="10,0,0,0" Click="Cancel_Click"/>
                            <TextBlock x:Name="StateHeading" Text="{loc:Localized Key=UiReady}" FontSize="21"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar x:Name="OperationProgress" Style="{StaticResource ProgressStyle}"
                                     Height="18" Minimum="0" Maximum="1" Value="0" Margin="0,12,0,8"/>
                        <TextBlock x:Name="ProgressLabel" Style="{StaticResource MutedText}" Text="{loc:Localized Key=UiWaiting}"/>
                        <TextBlock x:Name="StatusBox" Text="{loc:Localized Key=UiInstallPrompt}"
                                   Margin="0,9,0,0" FontSize="17"/>
                        <TextBlock x:Name="InstructionsBox" Style="{StaticResource MutedText}"
                                   Margin="0,5,0,0" FontSize="16"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WoodPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Localized Key=UiAdditionalActions}" FontSize="20" FontWeight="Bold" Margin="0,0,0,9"/>
                        <UniformGrid Columns="2" Rows="2">
                            <Button x:Name="RepairButton" Content="{loc:Localized Key=UiRepair}"
                                    Style="{StaticResource ActionButton}" Margin="0,0,5,6" Click="Repair_Click"/>
                            <Button x:Name="ImportWorldsButton" Content="{loc:Localized Key=UiImportWorlds}"
                                    Style="{StaticResource ActionButton}" Margin="5,0,0,6" Click="ImportWorlds_Click"/>
                            <Button x:Name="RetryLauncherButton"
                                    Style="{StaticResource ActionButton}" Margin="0,6,5,0" Click="Configure_Click">
                                <TextBlock Text="{loc:Localized Key=UiRestoreLauncher}" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="White"/>
                            </Button>
                            <Button x:Name="UninstallButton" Content="{loc:Localized Key=UiUninstall}"
                                    Style="{StaticResource ActionButton}" Margin="5,6,0,0" Click="Uninstall_Click"/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="15" Margin="2,10,0,0"
                                   Text="{loc:Localized Key=UiLauncherHint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WoodPanel}" Padding="16,8">
                    <Expander Header="{loc:Localized Key=UiDetails}" Style="{StaticResource CatalogExpander}" IsExpanded="False">
                        <StackPanel Margin="8,9,8,9">
                            <TextBlock Text="{loc:Localized Key=UiBuildInfo}"
                                       Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock x:Name="PackVersionText" Style="{StaticResource MutedText}"
                                       FontSize="15" Margin="0,0,0,6"/>
                            <TextBlock x:Name="InstallerVersionText" Style="{StaticResource MutedText}"
                                       FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DiagnosticText" Style="{StaticResource MutedText}"
                                       FontSize="14" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="OpenFolderButton" Content="{loc:Localized Key=UiOpenFolder}"
                                        Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="OpenFolder_Click"/>
                                <Button x:Name="OpenLogButton" Content="{loc:Localized Key=UiOpenLog}"
                                        Style="{StaticResource ActionButton}" Click="OpenLog_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="UninstallConfirmOverlay" Panel.ZIndex="100" Background="#B8000000"
              Visibility="Collapsed" Focusable="True" FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
              PreviewKeyDown="UninstallConfirmOverlay_PreviewKeyDown">
            <Border Style="{StaticResource WoodPanel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="22" Padding="22" MaxWidth="570">
                <StackPanel>
                    <TextBlock Text="{loc:Localized Key=UiUninstallConfirmTitle}" FontSize="24"
                               FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:Localized Key=UiUninstallConfirmMessage}" FontSize="18"
                               LineHeight="26" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UninstallCancelButton" Content="{loc:Localized Key=UiCancel}"
                                Style="{StaticResource ActionButton}" Margin="0,0,10,0"
                                Click="UninstallCancel_Click"/>
                        <Button x:Name="UninstallConfirmButton" Content="{loc:Localized Key=UiUninstall}"
                                Style="{StaticResource ActionButton}" Click="UninstallConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
